# Copia este archivo a .env.local y rellena los valores. Nunca versiones .env.local.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Buzón del equipo que recibe los mensajes del formulario de contacto.
# Con el remitente de pruebas onboarding@resend.dev, Resend solo entrega al correo
# del dueño de la cuenta: usa ese correo hasta verificar un dominio propio.
CONTACT_TO_EMAIL=

# Remitente del correo, p. ej. "Arcade Vault <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=
